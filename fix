docker exec -it open-webui python -c "import sqlite3; conn = sqlite3.connect('/app/backend/data/webui.db'); cursor = conn.cursor(); cursor.execute(\"DELETE FROM config WHERE value LIKE '%qwen3%'\"); print(f'Wiped configs: {cursor.rowcount}'); cursor.execute(\"UPDATE user SET settings = NULL WHERE settings LIKE '%qwen3%'\"); print(f'Reset user settings: {cursor.rowcount}'); cursor.execute(\"DELETE FROM config WHERE id = 'embedding_engine' AND value LIKE '%qwen3%'\"); print(f'Cleared embedding: {cursor.rowcount}'); conn.commit(); conn.close()"
